<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elegance Hire</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Poppins", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            background: #050509;
            color: #f7f7f7;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* NAVBAR / LOGO */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            padding: 16px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(5, 5, 12, 0.9);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            z-index: 1000;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-circle {
            width: 40px;
            height: 40px;
            border-radius: 999px;
            background: radial-gradient(circle at 30% 20%, #f8e7b5, #b88a3b);
            box-shadow: 0 0 18px rgba(255, 215, 128, 0.7);
        }

        .logo-text-main {
            font-size: 1.4rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .logo-text-sub {
            font-size: 0.75rem;
            opacity: 0.7;
        }

        .nav-links {
            display: flex;
            gap: 20px;
            font-size: 0.95rem;
        }

        .nav-links a {
            position: relative;
            padding-bottom: 4px;
            opacity: 0.8;
            transition: 0.2s;
        }

        .nav-links a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, #f8e7b5, #e0b85a);
            transition: width 0.2s;
        }

        .nav-links a:hover {
            opacity: 1;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* LAYOUT HELPERS */
        .page {
            padding-top: 80px;
        }

        .section {
            padding: 80px 8vw;
        }

        .section-title {
            font-size: 2.1rem;
            margin-bottom: 30px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .section-subtitle {
            font-size: 0.95rem;
            opacity: 0.7;
            max-width: 520px;
        }

        /* HERO + CAROUSEL */
        .hero {
            display: grid;
            grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.3fr);
            gap: 40px;
            align-items: center;
            padding: 100px 8vw 80px;
            background: radial-gradient(circle at top left, #1b1324, #050509 55%);
        }

        .hero-copy h1 {
            font-size: 3.2rem;
            line-height: 1.1;
            margin-bottom: 16px;
        }

        .hero-copy p {
            font-size: 1rem;
            opacity: 0.8;
            max-width: 420px;
            margin-bottom: 24px;
        }

        .hero-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 24px;
        }

        .badge {
            font-size: 0.8rem;
            padding: 6px 12px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            opacity: 0.85;
        }

        .hero-cta {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn-primary {
            padding: 10px 22px;
            border-radius: 999px;
            border: none;
            background: linear-gradient(135deg, #f8e7b5, #e0b85a);
            color: #20140b;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            box-shadow: 0 0 18px rgba(255, 215, 128, 0.5);
        }

        .btn-secondary {
            padding: 10px 22px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            background: transparent;
            color: #f7f7f7;
            font-size: 0.95rem;
            cursor: pointer;
        }

        .hero-meta {
            margin-top: 18px;
            font-size: 0.8rem;
            opacity: 0.6;
        }

        /* CAROUSEL WRAP */
        .hero-carousel {
            position: relative;
            border-radius: 22px;
            padding: 16px;
            background: radial-gradient(circle at top, rgba(255, 255, 255, 0.06), rgba(0, 0, 0, 0.9));
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
        }

        .carousel-window {
            overflow: hidden;
            border-radius: 18px;
        }

        .carousel-track {
            display: flex;
            transition: transform 0.6s ease;
        }

        .carousel-item {
            min-width: 100%;
            padding: 0;
        }

        .carousel-img-wrap {
            width: 100%;
            height: 360px;
            overflow: hidden;
        }

        .carousel-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .carousel-caption {
            padding: 14px 10px 4px;
        }

        .carousel-caption h3 {
            font-size: 1rem;
            margin-bottom: 4px;
        }

        .carousel-caption p {
            font-size: 0.85rem;
            opacity: 0.75;
        }

        .carousel-controls {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            pointer-events: none;
        }

        .carousel-btn {
            pointer-events: auto;
            width: 32px;
            height: 32px;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.4);
            background: rgba(5, 5, 12, 0.7);
            color: #f7f7f7;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 18px;
        }

        .carousel-dots {
            display: flex;
            gap: 6px;
            justify-content: center;
            margin-top: 8px;
        }

        .dot {
            width: 7px;
            height: 7px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.25);
        }

        .dot.active {
            background: #f8e7b5;
        }

        /* DRESS GALLERY */
        .gallery {
            background: #070711;
        }

        .gallery-grid {
            margin-top: 30px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 20px;
        }

        .dress-card {
            background: radial-gradient(circle at top, rgba(255, 255, 255, 0.06), #050509);
            border-radius: 16px;
            padding: 10px;
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .dress-img-wrap {
            width: 100%;
            height: 260px;
            overflow: hidden;
            border-radius: 12px;
        }

        .dress-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .dress-info {
            padding: 10px 4px 4px;
            font-size: 0.9rem;
        }

        .dress-info h3 {
            font-size: 0.95rem;
            margin-bottom: 2px;
        }

        .dress-meta {
            font-size: 0.8rem;
            opacity: 0.7;
        }

        /* CUSTOMER TRY-ONS */
        .tryons {
            background: #050509;
        }

        .tryon-grid {
            margin-top: 30px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 20px;
        }

        .tryon-card {
            border-radius: 16px;
            padding: 10px;
            background: radial-gradient(circle at top, rgba(255, 255, 255, 0.05), #050509);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .tryon-img-wrap {
            width: 100%;
            height: 260px;
            overflow: hidden;
            border-radius: 12px;
        }

        .tryon-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .tryon-caption {
            padding: 10px 4px 4px;
            font-size: 0.85rem;
            opacity: 0.8;
        }

        /* REVIEWS */
        .reviews {
            background: #070711;
        }

        .reviews-row {
            margin-top: 30px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 18px;
        }

        .review-card {
            padding: 16px;
            border-radius: 14px;
            background: radial-gradient(circle at top, rgba(255, 255, 255, 0.05), #050509);
            border: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 0.9rem;
        }

        .review-name {
            margin-top: 10px;
            font-size: 0.8rem;
            opacity: 0.7;
        }

        /* CONTACT */
        .contact {
            background: #050509;
        }

        .contact-grid {
            margin-top: 30px;
            display: grid;
            grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
            gap: 30px;
        }

        .contact-item {
            font-size: 0.95rem;
            margin-bottom: 10px;
        }

        .contact-item span {
            opacity: 0.7;
            font-size: 0.85rem;
        }

        .contact-card {
            padding: 18px;
            border-radius: 16px;
            background: radial-gradient(circle at top, rgba(255, 255, 255, 0.05), #050509);
            border: 1px solid rgba(255, 255, 255, 0.08);
            font-size: 0.9rem;
        }

        .footer {
            padding: 20px 8vw 30px;
            font-size: 0.8rem;
            opacity: 0.6;
            text-align: center;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* RESPONSIVE */
        @media (max-width: 900px) {
            .hero {
                grid-template-columns: 1fr;
                padding-top: 110px;
            }

            .nav-links {
                display: none;
            }
        }
    </style>
</head>
<body>
<div class="page">

    <!-- NAVBAR + LOGO -->
    <header class="navbar">
        <div class="logo-area">
            <div class="logo-circle"></div>
            <div>
                <div class="logo-text-main">Elegance Hire</div>
