            <button class="btn btn-outline" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">
              Enquire about this dress
            </button>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="carousel-item">
          <img src="dresses/dress2.jpg" alt="Emerald Wrap Dress">
          <div>
            <div class="dress-info-title">Emerald Wrap Dress</div>
            <div class="dress-meta">Sizes: 10–16 • Perfect for: Weddings, cocktail nights</div>
            <p class="dress-desc">
              A rich emerald wrap dress that suits a range of body types. Adjustable waist tie and floaty skirt make it a go‑to for weddings and special dinners.
            </p>
            <div class="tag-row">
              <span class="tag">Emerald</span>
              <span class="tag">Midi</span>
              <span class="tag">Wrap style</span>
            </div>
            <button class="btn btn-outline" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">
              Enquire about this dress
            </button>
          </div>
        </div>

        <!-- Slide 3 -->
        <div class="carousel-item">
          <img src="dresses/dress3.jpg" alt="Black Satin Slip">
          <div>
            <div class="dress-info-title">Black Satin Slip</div>
            <div class="dress-meta">Sizes: 6–14 • Perfect for: Birthdays, nights out</div>
            <p class="dress-desc">
              A classic black satin slip that can be dressed up or down. Pair with heels and jewellery for a timeless, effortless look.
            </p>
            <div class="tag-row">
              <span class="tag">Black</span>
              <span class="tag">Slip</span>
              <span class="tag">Versatile</span>
            </div>
            <button class="btn btn-outline" onclick="document.getElementById('contact').scrollIntoView({behavior:'smooth'})">
              Enquire about this dress
            </button>
          </div>
        </div>
      </div>

      <div class="carousel-controls">
        <button class="carousel-btn" id="prevDress">&#10094;</button>
        <button class="carousel-btn" id="nextDress">&#10095;</button>
      </div>
    </div>
  </div>
</section>

<!-- REVIEWS -->
<section class="section" id="reviews">
  <div class="section-inner">
    <h2 class="section-title">Reviews</h2>
    <div class="reviews-grid">
      <div class="review-card">
        “So easy to book and the dress fit perfectly. Loved that I could see the size and length clearly before hiring.”
        <div class="review-name">— Sarah, School Ball</div>
      </div>
      <div class="review-card">
        “Auntie was so helpful with trying on different styles. I felt really special on the night and didn’t have to buy something I’d only wear once.”
        <div class="review-name">— Mia, 21st Birthday</div>
      </div>
      <div class="review-card">
        “Great range of sizes and colours. The whole process was simple and the dress was in perfect condition.”
        <div class="review-name">— Emily, Wedding Guest</div>
      </div>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section class="section" id="about">
  <div class="section-inner">
    <h2 class="section-title">About Auntie’s Clothing Hire</h2>
    <div class="about-layout">
      <div class="about-card">
        <p>
          <span class="about-highlight">Auntie’s Clothing Hire</span> is a Perth‑based clothing hire business focused on helping you feel special without the stress of buying a new outfit for every event.
        </p>
        <p>
          With a curated collection of dresses in a range of sizes, colours, and styles, you can browse outfits, check details, and contact us directly to arrange your hire.
        </p>
        <p>
          We believe in reducing clothing waste by re‑wearing beautiful pieces instead of letting them sit in the back of a wardrobe after one night.
        </p>
      </div>
      <div class="about-card">
        <p><span class="about-highlight">Why choose us?</span></p>
        <ul style="padding-left:18px; margin:0;">
          <li>Affordable hire compared to buying new.</li>
          <li>Sizes and colours clearly displayed.</li>
          <li>Real customer reviews and photos.</li>
          <li>Friendly, personal service — you’re not just a booking number.</li>
          <li>Reduce waste by hiring instead of buying.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section class="section" id="contact">
  <div class="section-inner">
    <h2 class="section-title">Contact & Socials</h2>
    <div class="contact-grid">
      <div class="contact-card">
        <p><strong>Bookings & enquiries</strong></p>
        <p>Email: <a href="mailto:info@auntiesclothinghire.com">info@auntiesclothinghire.com</a></p>
        <p>
          Online bookings via Fresha:<br>
          <a href="https://www.fresha.com/a/dusktilldawn-hire-retail-wandi-40-bodeman-road-qfuch5iu" target="_blank">
            Click here to book on Fresha
          </a>
        </p>
        <p>Location: Wandi, WA (exact address provided with booking).</p>
      </div>
      <div class="contact-card">
        <p><strong>Socials</strong></p>
        <div class="social-row">
          <div class="social-pill">@auntiesclothinghire</div>
          <div class="social-pill">Instagram</div>
          <div class="social-pill">Facebook</div>
        </div>
        <p style="margin-top:14px; font-size:13px; color:var(--muted);">
          Follow us for new arrivals, try‑on videos, and real customer photos.
        </p>
      </div>
    </div>
  </div>
</section>

<footer>
  &copy; <span id="year"></span> Auntie’s Clothing Hire — Perth, WA. All rights reserved.
</footer>

<script>
// YEAR
document.getElementById("year").textContent = new Date().getFullYear();

// DRESS CAROUSEL
const track = document.querySelector(".carousel-track");
const slides = Array.from(document.querySelectorAll(".carousel-item"));
const prevBtn = document.getElementById("prevDress");
const nextBtn = document.getElementById("nextDress");
let currentIndex = 0;

function updateCarousel() {
  const width = slides[0].getBoundingClientRect().width;
  track.style.transform = `translateX(-${currentIndex * width}px)`;
}

nextBtn.addEventListener("click", () => {
  currentIndex = (currentIndex + 1) % slides.length;
  updateCarousel();
});

prevBtn.addEventListener("click", () => {
  currentIndex = (currentIndex - 1 + slides.length) % slides.length;
  updateCarousel();
});

window.addEventListener("resize", updateCarousel);

// Auto‑cycle every 6 seconds
setInterval(() => {
  currentIndex = (currentIndex + 1) % slides.length;
  updateCarousel();
}, 6000);
</script>

</body>
