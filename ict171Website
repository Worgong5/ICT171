<header>
  <div class="logo">Auntie’s Clothing Hire</div>
  <nav>
    <a href="#dresses">Dresses</a>
    <a href="#reviews">Reviews</a>
    <a href="#about">About</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <h1>Hire stunning outfits without the stress of DMs.</h1>
      <h2>Affordable hire • Feel special • Reduce waste</h2>
      <ul class="hero-bullets">
        <li>Clear sizes, colours, and fit notes.</li>
        <li>Real customer reviews so you know what to expect.</li>
        <li>Reduce clothing waste by hiring, not buying.</li>
      </ul>
      <div class="hero-cta">
        <a href="#dresses" class="btn btn-primary">Browse dresses</a>
        <a href="#contact" class="btn btn-outline">Contact & bookings</a>
      </div>
    </div>
    <div class="hero-image">
      <!-- Replace hero.jpg with your own hero image in the same folder -->
      <img src="hero.jpg" alt="Elegant dress and heels">
    </div>
  </div>
</section>

<!-- DRESSES CAROUSEL -->
<section class="section" id="dresses">
  <div class="section-inner">
    <h2 class="section-title">Featured Dresses</h2>

    <div class="carousel" id="dressCarousel">
      <div class="carousel-track">
        <!-- Slide 1 -->
        <div class="carousel-item">
          <img src="dresses/dress1.jpg" alt="Blush Satin Gown">
          <div>
            <div class="dress-info-title">Blush Satin Gown</div>
            <div class="dress-meta">Sizes: 8–12 • Perfect for: School balls, formal events</div>
