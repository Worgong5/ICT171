            </div>

            <div class="carousel-dots" id="heroDots">
                <div class="dot active"></div>
                <div class="dot"></div>
                <div class="dot"></div>
                <div class="dot"></div>
            </div>
        </div>
    </section>

    <!-- DRESS GALLERY -->
    <section id="gallery" class="section gallery">
        <h2 class="section-title">Featured dresses</h2>
        <p class="section-subtitle">A small preview of the collection. More styles, colours and sizes available on request.</p>

        <div class="gallery-grid">
            <div class="dress-card">
                <div class="dress-img-wrap">
                    <img src="dress1.jpg" alt="Gold Sequin Gown">
