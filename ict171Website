            <div class="dress-card">
                <div class="dress-img-wrap">
                    <img src="dress3.jpg" alt="Silver Evening Dress">
                </div>
                <div class="dress-info">
                    <h3>Silver Evening Dress</h3>
                    <div class="dress-meta">Size 6 • $75 hire • Metallic, side split</div>
                </div>
            </div>

            <div class="dress-card">
                <div class="dress-img-wrap">
                    <img src="dress4.jpg" alt="Champagne Luxe Dress">
                </div>
                <div class="dress-info">
                    <h3>Champagne Luxe Dress</h3>
                    <div class="dress-meta">Size 8 • $85 hire • Soft champagne tone</div>
