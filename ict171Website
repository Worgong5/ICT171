        <h2 class="section-title">Customer try‑ons</h2>
        <p class="section-subtitle">Real girls, real events. Showcase your look here after your hire.</p>

        <div class="tryon-grid">
            <!-- Replace these with real try-on photos later -->
            <div class="tryon-card">
                <div class="tryon-img-wrap">
