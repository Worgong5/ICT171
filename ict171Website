  background: radial-gradient(circle at top, #222 0, #000 55%);
  color: var(--light);
}

/* HEADER */
header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 32px;
  background: rgba(0,0,0,0.85);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(212,175,55,0.3);
}

.logo {
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--primary);
  text-transform: uppercase;
  font-size: 14px;
}

nav a {
  color: var(--light);
  text-decoration: none;
  margin-left: 18px;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  position: relative;
}

nav a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -4px;
  width: 0;
  height: 2px;
  background: var(--primary);
  transition: width 0.2s ease;
}

nav a:hover::after {
  width: 100%;
}

/* LAYOUT HELPERS */
.section {
  padding: 60px 20px;
}

.section-inner {
  max-width: 1100px;
  margin: 0 auto;
}

.section-title {
  text-align: center;
  font-size: 26px;
  color: var(--primary);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  margin-bottom: 28px;
}

/* HERO */
.hero {
  padding: 80px 20px 60px;
}

.hero-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
  gap: 40px;
  align-items: center;
}

.hero-text h1 {
  font-size: 34px;
  margin: 0 0 14px;
  color: var(--primary);
}

.hero-text h2 {
  font-size: 18px;
  font-weight: 400;
  color: var(--muted);
  margin: 0 0 18px;
}

.hero-bullets {
  list-style: none;
  padding: 0;
  margin: 0 0 22px;
  font-size: 14px;
  color: var(--light);
}

.hero-bullets li::before {
  content: "• ";
  color: var(--primary);
}

.hero-cta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.btn {
  border-radius: 999px;
  padding: 10px 20px;
  font-size: 14px;
  border: 1px solid var(--primary);
  background: transparent;
  color: var(--primary);
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
}

.btn-primary {
  background: var(--primary);
  color: #000;
  box-shadow: 0 0 18px rgba(212,175,55,0.4);
}

.btn-primary:hover {
  box-shadow: 0 0 26px rgba(212,175,55,0.7);
}

.btn-outline:hover {
  background: rgba(212,175,55,0.1);
}

.hero-image {
  border-radius: 18px;
  border: 1px solid rgba(212,175,55,0.5);
  overflow: hidden;
  position: relative;
  min-height: 260px;
  background: radial-gradient(circle at top, #333 0, #000 60%);
}

.hero-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(1.1);
}

/* DRESSES CAROUSEL */
.carousel {
  position: relative;
  overflow: hidden;
  border-radius: 18px;
  border: 1px solid rgba(212,175,55,0.4);
  background: #111;
}

.carousel-track {
  display: flex;
  transition: transform 0.4s ease;
}

.carousel-item {
  min-width: 100%;
  padding: 20px;
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  gap: 24px;
  align-items: center;
}

.carousel-item img {
  width: 100%;
  height: 320px;
  object-fit: cover;
  border-radius: 12px;
  border: 1px solid rgba(212,175,55,0.6);
}

.dress-info-title {
  font-size: 20px;
  margin-bottom: 8px;
  color: var(--primary);
}

.dress-meta {
  font-size: 14px;
  color: var(--muted);
  margin-bottom: 10px;
}

.dress-desc {
  font-size: 14px;
  margin-bottom: 16px;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}

.tag {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid rgba(212,175,55,0.6);
  color: var(--primary);
}

.carousel-controls {
  position: absolute;
  inset: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  pointer-events: none;
}

.carousel-btn {
  pointer-events: auto;
  background: rgba(0,0,0,0.6);
  border-radius: 999px;
  border: 1px solid rgba(212,175,55,0.7);
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: var(--primary);
  margin: 0 10px;
}

/* REVIEWS */
.reviews-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 18px;
}

.review-card {
  background: rgba(10,10,10,0.9);
  border-radius: 14px;
  padding: 16px 18px;
  border: 1px solid rgba(212,175,55,0.3);
  font-size: 14px;
}

.review-name {
  margin-top: 10px;
  font-weight: 600;
  color: var(--primary);
  font-size: 13px;
}

/* ABOUT */
.about-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  gap: 28px;
  align-items: start;
}

.about-card {
  background: rgba(10,10,10,0.9);
  border-radius: 16px;
  padding: 20px 22px;
  border: 1px solid rgba(212,175,55,0.3);
  font-size: 14px;
}

.about-highlight {
  color: var(--primary);
  font-weight: 600;
}

/* CONTACT */
.contact-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  gap: 26px;
}

.contact-card {
  background: rgba(10,10,10,0.9);
  border-radius: 16px;
  padding: 20px 22px;
  border: 1px solid rgba(212,175,55,0.3);
  font-size: 14px;
}

.contact-card a {
  color: var(--primary);
  text-decoration: none;
}

.contact-card a:hover {
  text-decoration: underline;
}

.social-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 10px;
}

.social-pill {
  border-radius: 999px;
  border: 1px solid rgba(212,175,55,0.5);
  padding: 6px 12px;
  font-size: 12px;
}

/* FOOTER */
footer {
  text-align: center;
  padding: 18px;
  font-size: 12px;
  color: var(--muted);
  border-top: 1px solid rgba(212,175,55,0.25);
  background: #050505;
}

/* RESPONSIVE */
@media (max-width: 900px) {
  .hero-inner,
  .carousel-item,
  .about-layout,
  .contact-grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .hero {
    padding-top: 60px;
  }
}

@media (max-width: 600px) {
  header {
    padding: 10px 16px;
  }
  .hero-text h1 {
    font-size: 26px;
  }
}
