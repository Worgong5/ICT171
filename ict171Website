                <div class="dress-info">
                    <h3>Gold Sequin Gown</h3>
                    <div class="dress-meta">Size 8 • $80 hire • Full‑length, open back</div>
                </div>
            </div>

            <div class="dress-card">
                <div class="dress-img-wrap">
                    <img src="dress2.jpg" alt="Black Satin Slip">
                </div>
                <div class="dress-info">
                    <h3>Black Satin Slip</h3>
