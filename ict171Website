                    </div>
                    <!-- Slide 3 -->
                    <div class="carousel-item">
                        <div class="carousel-img-wrap">
                            <img src="dress3.jpg" alt="Silver Evening Dress">
                        </div>
                        <div class="carousel-caption">
                            <h3>Silver Evening Dress</h3>
                            <p>Size 6 • Soft metallic with side split.</p>
                        </div>
                    </div>
                    <!-- Slide 4 -->
                    <div class="carousel-item">
                        <div class="carousel-img-wrap">
                            <img src="dress4.jpg" alt="Champagne Luxe Dress">
                        </div>
                        <div class="carousel-caption">
                            <h3>Champagne Luxe Dress</h3>
                            <p>Size 8 • Romantic champagne tone, fitted bodice.</p>
